<% layout('layouts/alumniboilerplate') %>

<main class="main-content">
  <div class="section-header-flex">
    <div>
      <h1 style="font-size: 1.6rem; font-weight: 800; color: var(--slate-900);">
        Course Management
      </h1>
      <p style="color: var(--slate-500); font-size: 0.9rem;">
        Manage academic degree programs and course offerings.
      </p>
    </div>

    <button class="btn btn-primary" id="add-course-btn">
      <i data-lucide="plus-circle"></i>
      Add New Course
    </button>
  </div>

  <div class="profile-card-block" style="margin-top: 1.5rem;">
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
        <thead>
          <tr style="border-bottom: 2px solid var(--slate-200); color: var(--slate-600);">
            <th style="padding: 12px 16px; font-weight: 700;">Course Code</th>
            <th style="padding: 12px 16px; font-weight: 700;">Course Name / Description</th>
            <th style="padding: 12px 16px; font-weight: 700; text-align: right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (courses && courses.length > 0) { %>
            <% for (let course of courses) { %>
              <tr style="border-bottom: 1px solid var(--slate-100);">
                <td style="padding: 14px 16px; font-weight: 800; color: var(--primary);">
                  <%= course.courseCode %>
                </td>
                <td style="padding: 14px 16px; color: var(--slate-800); font-weight: 600;">
                  <%= course.courseName %>
                </td>
                <td style="padding: 14px 16px; text-align: right;">
                  <div style="display: flex; justify-content: flex-end; gap: 8px;">
                    <button
                      type="button"
                      class="btn btn-outline btn-sm open-edit-course-btn"
                      data-id="<%= course._id %>"
                      data-code="<%= course.courseCode %>"
                      data-name="<%= course.courseName %>"
                    >
                      <i data-lucide="pencil" style="width: 14px; height: 14px;"></i>
                      Edit
                    </button>

                    <form
                      action="/alumni/courses/<%= course._id %>?_method=DELETE"
                      method="POST"
                      style="display: inline;"
                      class="delete-confirm-form"
                      data-confirm="Are you sure you want to delete this course?"
                    >
                      <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                        Delete
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% } %>
          <% } else { %>
            <tr>
              <td colspan="3" style="padding: 24px; text-align: center; color: var(--slate-500);">
                No courses found. Click "Add New Course" to add one.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<!-- ADD COURSE MODAL -->
<div class="modal-backdrop" id="add-course-modal">
  <div class="modal-card" style="max-width: 500px;">
    <div class="modal-header">
      <h3>Add New Course</h3>
      <button type="button" class="modal-close-btn" id="close-add-course-btn">&times;</button>
    </div>

    <form action="/alumni/courses" method="POST">
      <div class="form-group">
        <label for="add-course-code">Course Code</label>
        <input
          type="text"
          id="add-course-code"
          name="courseCode"
          class="form-control"
          placeholder="e.g. BSCS"
          required
        />
      </div>

      <div class="form-group">
        <label for="add-course-name">Course Name / Title</label>
        <input
          type="text"
          id="add-course-name"
          name="courseName"
          class="form-control"
          placeholder="e.g. Bachelor of Science in Computer Science"
          required
        />
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem;">
        <button type="button" class="btn btn-outline" id="cancel-add-course-btn">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Course</button>
      </div>
    </form>
  </div>
</div>

<!-- EDIT COURSE MODAL -->
<div class="modal-backdrop" id="edit-course-modal">
  <div class="modal-card" style="max-width: 500px;">
    <div class="modal-header">
      <h3>Edit Course</h3>
      <button type="button" class="modal-close-btn" id="close-edit-course-btn">&times;</button>
    </div>

    <form id="edit-course-form" method="POST">
      <div class="form-group">
        <label for="edit-course-code">Course Code</label>
        <input
          type="text"
          id="edit-course-code"
          name="courseCode"
          class="form-control"
          required
        />
      </div>

      <div class="form-group">
        <label for="edit-course-name">Course Name / Title</label>
        <input
          type="text"
          id="edit-course-name"
          name="courseName"
          class="form-control"
          required
        />
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem;">
        <button type="button" class="btn btn-outline" id="cancel-edit-course-btn">Cancel</button>
        <button type="submit" class="btn btn-primary">Update Course</button>
      </div>
    </form>
  </div>
</div>
