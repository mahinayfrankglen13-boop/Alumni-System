<% layout('layouts/alumniboilerplate') %>

<main class="main-content">
  <div class="welcome-banner">
    <div>
      <h1 class="welcome-title">
        Welcome back, <span><%= currentUser ? currentUser.fullName : 'Alumni' %></span>!
      </h1>
      <p class="welcome-subtitle">
        Here is what is happening across your MSU-MCEST Alumni network today.
      </p>
    </div>
  </div>

  <!-- Dashboard Stats Grid -->
  <div class="dash-stats-grid">
    <div class="dash-stat-card">
      <div class="dash-stat-icon"><i data-lucide="users"></i></div>
      <div>
        <div class="dash-stat-number"><%= alumniCount %></div>
        <div class="dash-stat-label">Active Alumni</div>
      </div>
    </div>

    <div class="dash-stat-card">
      <div class="dash-stat-icon gold"><i data-lucide="briefcase"></i></div>
      <div>
        <div class="dash-stat-number"><%= jobCount %></div>
        <div class="dash-stat-label">Open Job Listings</div>
      </div>
    </div>

    <div class="dash-stat-card">
      <div class="dash-stat-icon blue"><i data-lucide="megaphone"></i></div>
      <div>
        <div class="dash-stat-number"><%= announcementCount %></div>
        <div class="dash-stat-label">Announcements</div>
      </div>
    </div>

    <div class="dash-stat-card">
      <div class="dash-stat-icon purple"><i data-lucide="graduation-cap"></i></div>
      <div>
        <div class="dash-stat-number"><%= courses.length %></div>
        <div class="dash-stat-label">Degree Programs</div>
      </div>
    </div>
  </div>

  <!-- Feed Grid -->
  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.75rem;">

    <!-- Announcements -->
    <div>
      <div class="section-header-flex">
        <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--slate-900);">
          <i data-lucide="megaphone" style="color: var(--primary);"></i>
          Campus Announcements
        </h2>
        <a href="/alumni/announcement" style="font-size: 0.82rem; font-weight: 700; color: var(--primary);">
          View All &rarr;
        </a>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <% for (let announcement of announcements) { %>
          <div style="background: #FFFFFF; border-radius: 16px; border: 1px solid var(--slate-200); padding: 1.5rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--primary); background: var(--primary-light); padding: 3px 8px; border-radius: 6px;">
                Campus Announcement
              </span>

              <span style="font-size: 0.8rem; color: var(--slate-400);">
                <%= announcement.createdAt.toLocaleDateString() %>
              </span>
            </div>

            <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--slate-900); margin-bottom: 0.5rem;">
              <%= announcement.title %>
            </h3>

            <p style="font-size: 0.92rem; color: var(--slate-600); line-height: 1.6;">
              <%= announcement.content %>
            </p>
          </div>
        <% } %>

        <% if (announcements.length === 0) { %>
          <div style="background: #FFFFFF; border-radius: 16px; border: 1px solid var(--slate-200); padding: 1.5rem;">
            <p style="color: var(--slate-500); margin: 0;">
              No announcements available.
            </p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Quick Jobs -->
    <div>
      <div class="section-header-flex">
        <h2 style="font-size: 1.15rem; font-weight: 800; color: var(--slate-900);">
          Quick Jobs
        </h2>
        <a href="/alumni/jobs" style="font-size: 0.82rem; font-weight: 700; color: var(--primary);">
          View All &rarr;
        </a>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% if (jobs && jobs.length > 0) { %>
          <% for (let job of jobs) { %>
            <div style="background: #FFFFFF; border-radius: 14px; border: 1px solid var(--slate-200); padding: 1.1rem; box-shadow: var(--shadow-sm);">
              <div style="font-size: 0.78rem; font-weight: 800; color: var(--gold);">
                <%= job.company %>
              </div>
              <div style="font-size: 0.95rem; font-weight: 800; color: var(--slate-900); margin-bottom: 4px;">
                <%= job.title %>
              </div>
              <div style="font-size: 0.78rem; color: var(--slate-500);">
                Posted by: <%= job.postedBy ? job.postedBy.fullName : 'Alumni' %>
              </div>
            </div>
          <% } %>
        <% } else { %>
          <div style="background: #FFFFFF; border-radius: 14px; border: 1px solid var(--slate-200); padding: 1.1rem;">
            <p style="color: var(--slate-500); margin: 0; font-size: 0.88rem;">
              No open job listings available.
            </p>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</main>