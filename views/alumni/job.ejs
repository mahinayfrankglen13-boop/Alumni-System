<% layout('layouts/alumniboilerplate') %>
<main class="main-content">
  <div class="section-header-flex">
    <div>
      <h1 style="font-size: 1.6rem; font-weight: 800; color: var(--slate-900);">
        Career & Job Opportunities
      </h1>
      <p style="color: var(--slate-500); font-size: 0.9rem;">
        Explore career openings posted by alumni and industry partners.
      </p>
    </div>

    <button class="btn btn-primary" id="post-job-btn">
      <i data-lucide="plus-circle"></i>
      Post Job Opportunity
    </button>
  </div>

  <!-- JOBS GRID -->
  <div class="jobs-grid">
    <% for (let job of jobs) { %>
      <div class="job-card">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
            <div class="job-company-tag">
              <%= job.company %>
            </div>

            <div>
              <% if (job.status === 'approved') { %>
                <span class="privacy-status-badge public" style="background:#dcfce7;color:#166534;font-size:0.75rem;padding:3px 8px;">
                  <i data-lucide="check-circle" style="width:12px;height:12px;"></i> Approved
                </span>
              <% } else if (job.status === 'rejected') { %>
                <span class="privacy-status-badge private" style="background:#fee2e2;color:#991b1b;font-size:0.75rem;padding:3px 8px;">
                  <i data-lucide="x-circle" style="width:12px;height:12px;"></i> Rejected
                </span>
              <% } else { %>
                <span class="privacy-status-badge private" style="background:#fef3c7;color:#92400e;font-size:0.75rem;padding:3px 8px;">
                  <i data-lucide="clock" style="width:12px;height:12px;"></i> Pending Approval
                </span>
              <% } %>
            </div>
          </div>

          <div class="job-title">
            <%= job.title %>
          </div>

          <div class="job-meta-row">
            <div>
              <i data-lucide="user" style="width: 14px; height: 14px;"></i>
              Posted by: <%= job.postedBy?.fullName || 'Alumni' %>
            </div>

            <div>
              <i data-lucide="calendar" style="width: 14px; height: 14px;"></i>
              <%= new Date(job.createdAt).toLocaleDateString() %>
            </div>
          </div>

          <p class="job-desc">
            <%= job.description %>
          </p>
        </div>

        <!-- JOB FOOTER -->
        <div class="job-card-footer" style="flex-wrap: wrap; gap: 8px;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <% if (currentUser && currentUser.role === 'admin') { %>
              <% if (job.status === 'pending') { %>
                <form action="/alumni/jobs/<%= job._id %>/status?_method=PUT" method="POST" style="display: inline;">
                  <input type="hidden" name="status" value="approved">
                  <button type="submit" class="btn btn-sm" style="background: #16a34a; color: white; border: none; padding: 4px 10px;">
                    <i data-lucide="check" style="width: 14px; height: 14px;"></i> Approve
                  </button>
                </form>
                <form action="/alumni/jobs/<%= job._id %>/status?_method=PUT" method="POST" style="display: inline;">
                  <input type="hidden" name="status" value="rejected">
                  <button type="submit" class="btn btn-sm" style="background: #dc2626; color: white; border: none; padding: 4px 10px;">
                    <i data-lucide="x" style="width: 14px; height: 14px;"></i> Reject
                  </button>
                </form>
              <% } else if (job.status === 'rejected') { %>
                <form action="/alumni/jobs/<%= job._id %>/status?_method=PUT" method="POST" style="display: inline;">
                  <input type="hidden" name="status" value="approved">
                  <button type="submit" class="btn btn-sm" style="background: #16a34a; color: white; border: none; padding: 4px 10px;">
                    <i data-lucide="check" style="width: 14px; height: 14px;"></i> Approve
                  </button>
                </form>
              <% } %>
            <% } %>
          </div>

          <div style="display: flex; gap: 8px;">
            <!-- EDIT (Poster Only) -->
            <% if (currentUser && job.postedBy && job.postedBy._id.toString() === currentUser._id.toString()) { %>
              <button
                type="button"
                class="btn btn-outline btn-sm"
                class="btn btn-outline btn-sm open-edit-job-btn"
                data-id="<%= job._id %>"
                data-title="<%= job.title %>"
                data-company="<%= job.company %>"
                data-description="<%= job.description %>"
                data-location="<%= job.location || '' %>"
                data-application-url="<%= job.applicationUrl %>"
              >
                <i data-lucide="pencil" style="width: 14px; height: 14px;"></i>
                Edit
              </button>
            <% } %>

            <!-- DELETE (Poster or Admin, approved jobs only) -->
            <% if (job.status !== 'pending' && currentUser && (currentUser.role === 'admin' || (job.postedBy && job.postedBy._id.toString() === currentUser._id.toString()))) { %>
              <form
                action="/alumni/jobs/<%= job._id %>?_method=DELETE"
                method="POST"
                style="display: inline;"
                class="delete-confirm-form"
                data-confirm="Are you sure you want to delete this job opportunity?"
              >
                <button type="submit" class="btn btn-outline-danger btn-sm">
                  <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                  Delete
                </button>
              </form>
            <% } %>

            <!-- APPLY NOW (Non-Admin Only) -->
            <% if (currentUser && currentUser.role !== 'admin') { %>
              <a
                href="<%= job.applicationUrl %>"
                class="btn btn-primary btn-sm"
                target="_blank"
                rel="noopener noreferrer"
              >
                <i data-lucide="send" style="width: 14px; height: 14px;"></i>
                Apply Now
              </a>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</main>

<!-- POST JOB MODAL -->
<div class="modal-backdrop" id="post-job-modal">
  <div class="modal-card">
    <div class="modal-header">
      <h3>Post New Job Opportunity</h3>

      <button
        type="button"
        class="modal-close-btn"
        id="close-post-job-btn"
      >
        &times;
      </button>
    </div>

    <form action="/alumni/jobs" method="POST">
      <div class="form-group">
        <label for="post-title">Job Title</label>
        <input
          type="text"
          id="post-title"
          name="title"
          class="form-control"
          placeholder="e.g. Junior Frontend Developer"
          required
        />
      </div>

      <div class="form-group">
        <label for="post-company">Company Name</label>
        <input
          type="text"
          id="post-company"
          name="company"
          class="form-control"
          placeholder="e.g. TechCorp PH"
          required
        />
      </div>

      <div class="form-group">
        <label for="post-description">Job Description</label>
        <textarea
          id="post-description"
          name="description"
          class="form-control"
          placeholder="Provide job details, requirements, and application instructions..."
          required
        ></textarea>
      </div>

      <div class="form-group">
        <label for="post-location">Location</label>
        <input
          type="text"
          id="post-location"
          name="location"
          class="form-control"
          placeholder="e.g. Iligan City, Philippines"
        />
      </div>

      <div class="form-group">
        <label for="post-application-url">Application URL</label>
        <input
          type="url"
          id="post-application-url"
          name="applicationUrl"
          class="form-control"
          placeholder="https://example.com/apply"
          required
        />
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem;">
        <button
          type="button"
          class="btn btn-outline"
          id="cancel-post-job-btn"
        >
          Cancel
        </button>

        <button type="submit" class="btn btn-primary">
          Publish Opportunity
        </button>
      </div>
    </form>
  </div>
</div>

<!-- EDIT JOB MODAL -->
<div class="modal-backdrop" id="edit-job-modal">
  <div class="modal-card">
    <div class="modal-header">
      <h3>Edit Job Opportunity</h3>

      <button
        type="button"
        class="modal-close-btn"
        id="close-edit-job-btn"
      >
        &times;
      </button>
    </div>

    <form id="edit-job-form" method="POST">
      <div class="form-group">
        <label for="edit-title">Job Title</label>
        <input
          type="text"
          id="edit-title"
          name="title"
          class="form-control"
          required
        />
      </div>

      <div class="form-group">
        <label for="edit-company">Company Name</label>
        <input
          type="text"
          id="edit-company"
          name="company"
          class="form-control"
          required
        />
      </div>

      <div class="form-group">
        <label for="edit-description">Job Description</label>
        <textarea
          id="edit-description"
          name="description"
          class="form-control"
          required
        ></textarea>
      </div>

      <div class="form-group">
        <label for="edit-location">Location</label>
        <input
          type="text"
          id="edit-location"
          name="location"
          class="form-control"
        />
      </div>

      <div class="form-group">
        <label for="edit-application-url">Application URL</label>
        <input
          type="url"
          id="edit-application-url"
          name="applicationUrl"
          class="form-control"
          required
        />
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem;">
        <button
          type="button"
          class="btn btn-outline"
          id="cancel-edit-job-btn"
        >
          Cancel
        </button>

        <button type="submit" class="btn btn-primary">
          Save Changes
        </button>
      </div>
    </form>
  </div>
</div>
