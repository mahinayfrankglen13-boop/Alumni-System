<% layout('layouts/alumniboilerplate') %>

<main class="main-content">
  <div class="section-header-flex">
    <div>
      <h1 style="font-size: 1.6rem; font-weight: 800; color: var(--slate-900);">
        Alumni Directory & Network
      </h1>
      <p style="color: var(--slate-500); font-size: 0.9rem;">
        Find and connect with fellow MSU-MCEST graduates.
      </p>
    </div>
  </div>

  <form method="GET" action="/alumni/directory">
    <div class="directory-controls">
      <div class="directory-search-input">
        <i data-lucide="search" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--slate-400); width: 18px; height: 18px;"></i>
        <input
          type="text"
          name="search"
          value="<%= search || '' %>"
          placeholder="Search by name, course, or graduation year..."
        />
      </div>

      <select class="directory-filter-select" name="course">
        <option value="">All Courses</option>
        <% for (let course of courses) { %>
          <option value="<%= course.courseCode %>" <%= selectedCourse === course.courseCode ? 'selected' : '' %>>
            <%= course.courseCode %>
          </option>
        <% } %>
      </select>

      <select class="directory-filter-select" name="graduationYear">
        <option value="">All Graduation Years</option>
        <% for (let year of graduationYears) { %>
          <option value="<%= year %>" <%= selectedYear == year ? 'selected' : '' %>>
            Batch <%= year %>
          </option>
        <% } %>
      </select>

      <button type="submit" class="btn btn-primary btn-sm">Search</button>
    </div>
  </form>

  <div class="alumni-grid">
    <% if (!alumni || alumni.length === 0) { %>
      <div style="grid-column: 1 / -1; text-align: center; padding: 3rem 1rem; background: #fff; border-radius: var(--radius-md); border: 1px dashed var(--slate-300);">
        <i data-lucide="users" style="width: 48px; height: 48px; color: var(--slate-400); margin-bottom: 12px;"></i>
        <h3 style="margin: 0 0 6px 0; color: var(--slate-800); font-weight: 700;">No Alumni Found</h3>
        <p style="margin: 0; color: var(--slate-500); font-size: 0.9rem;">We couldn't find any alumni matching your filter criteria.</p>
      </div>
    <% } else { %>
      <% for (let alum of alumni) { %>
        <div class="alumni-card">
          <div>
            <div class="alumni-card-top">
              <div class="alumni-avatar-lg" style="overflow:hidden;padding:0;">
                <img src="<%= (alum.profileImage && alum.profileImage.url) ? alum.profileImage.url : 'https://res.cloudinary.com/fad0iwxm/image/upload/v1786894165/defaul-prof_ryln3w.jpg' %>" alt="<%= alum.fullName || 'Alumni' %>" style="width:100%;height:100%;object-fit:cover;">
              </div>
              <div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                  <div class="alumni-name"><%= alum.fullName || 'N/A' %></div>
                  <% if (currentUser && currentUser.role === 'admin') { %>
                    <% if (alum.status === 'pending') { %>
                      <span class="privacy-status-badge private" style="background:#fef3c7;color:#92400e;font-size:0.72rem;padding:2px 6px;">
                        <i data-lucide="clock" style="width:12px;height:12px;"></i> Pending
                      </span>
                    <% } else { %>
                      <span class="privacy-status-badge public" style="background:#dcfce7;color:#166534;font-size:0.72rem;padding:2px 6px;">
                        <i data-lucide="check-circle" style="width:12px;height:12px;"></i> Approved
                      </span>
                    <% } %>
                  <% } %>
                </div>
                <span class="alumni-course-badge">
                  <%= (alum.course && alum.course.courseCode) ? alum.course.courseCode : 'N/A' %> &bull; Batch <%= alum.graduationYear || 'N/A' %>
                </span>
              </div>
            </div>

            <div style="margin-top: 12px; color: var(--slate-500); font-size: 0.85rem; line-height: 1.5;">
              <%= alum.bio || 'No bio provided.' %>
            </div>
          </div>

          <div class="alumni-card-footer" style="flex-wrap: wrap; gap: 8px;">
            <div style="display: flex; gap: 6px;">
              <% if (currentUser && currentUser.role === 'admin') { %>
                <% if (alum.status === 'pending') { %>
                  <form action="/alumni/users/<%= alum._id %>/status?_method=PUT" method="POST" style="display: inline;">
                    <input type="hidden" name="status" value="approved">
                    <button type="submit" class="btn btn-sm" style="background: #16a34a; color: white; border: none; padding: 4px 10px;">
                      <i data-lucide="check" style="width: 14px; height: 14px;"></i> Approve
                    </button>
                  </form>
                <% } %>
                <form action="/alumni/users/<%= alum._id %>?_method=DELETE" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this alumni user?');">
                  <button type="submit" class="btn btn-outline-danger btn-sm" style="padding: 4px 10px;">
                    <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i> Delete
                  </button>
                </form>
              <% } %>
            </div>

            <button
              type="button"
              class="btn btn-outline-primary btn-sm view-profile-btn"
              data-name="<%= alum.fullName %>"
              data-course="<%= (alum.course && alum.course.courseCode) ? alum.course.courseCode : 'N/A' %>"
              data-year="<%= alum.graduationYear || 'N/A' %>"
              data-bio="<%= alum.bio || 'No bio provided.' %>"
              data-image="<%= (alum.profileImage && alum.profileImage.url) ? alum.profileImage.url : 'https://res.cloudinary.com/fad0iwxm/image/upload/v1786894165/defaul-prof_ryln3w.jpg' %>"
            >
              <i data-lucide="user" style="width: 14px; height: 14px;"></i>
              View Profile
            </button>
          </div>
        </div>
      <% } %>
    <% } %>
  </div>
</main>

<!-- VIEW PROFILE MODAL -->
<div class="modal-backdrop" id="view-profile-modal">
  <div class="modal-card" style="max-width: 560px;">
    <div class="modal-header">
      <h3 style="display: flex; align-items: center; gap: 8px; color: var(--primary);">
        <i data-lucide="user" style="color: var(--primary); width: 20px; height: 20px;"></i>
        Alumni Profile
      </h3>
      <button type="button" class="modal-close-btn" id="close-view-profile-btn">
        &times;
      </button>
    </div>

    <div class="modal-body" style="display: flex; flex-direction: column; gap: 1.25rem;">
      <div style="display: flex; align-items: center; gap: 1rem; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); padding: 1.25rem; border-radius: var(--radius-md); color: white;">
        <div
          id="modal-alumni-avatar"
          style="width: 54px; height: 54px; font-size: 1.25rem; background: rgba(255,255,255,0.2); color: white; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: 800; flex-shrink: 0; border: 2px solid rgba(255,255,255,0.4);"
        >
          AU
        </div>
        <div>
          <h4 id="modal-alumni-name" style="margin: 0; font-size: 1.2rem; font-weight: 800; color: white;">
            Alumni Name
          </h4>
          <span id="modal-alumni-degree" class="alumni-course-badge" style="background: rgba(255,255,255,0.2); color: #fff; border: none; margin-top: 4px; display: inline-block;">
            Course &bull; Batch
          </span>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1rem; background: var(--slate-50); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--slate-200);">
        <div>
          <div style="font-size: 0.75rem; font-weight: 700; color: var(--slate-400); text-transform: uppercase; letter-spacing: 0.5px;">
            Full Name
          </div>
          <div id="modal-alumni-name-detail" style="font-weight: 700; color: var(--slate-800); font-size: 0.95rem; margin-top: 2px;">
            N/A
          </div>
        </div>

        <div>
          <div style="font-size: 0.75rem; font-weight: 700; color: var(--slate-400); text-transform: uppercase; letter-spacing: 0.5px;">
            Course
          </div>
          <div id="modal-alumni-course" style="font-weight: 700; color: var(--slate-800); font-size: 0.95rem; margin-top: 2px;">
            N/A
          </div>
        </div>

        <div>
          <div style="font-size: 0.75rem; font-weight: 700; color: var(--slate-400); text-transform: uppercase; letter-spacing: 0.5px;">
            Batch Year
          </div>
          <div id="modal-alumni-year" style="font-weight: 700; color: var(--slate-800); font-size: 0.95rem; margin-top: 2px;">
            N/A
          </div>
        </div>

        <div>
          <div style="font-size: 0.75rem; font-weight: 700; color: var(--slate-400); text-transform: uppercase; letter-spacing: 0.5px;">
            Bio
          </div>
          <div id="modal-alumni-bio" style="font-weight: 500; color: var(--slate-700); font-size: 0.9rem; line-height: 1.6; margin-top: 4px;">
            No bio provided.
          </div>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; margin-top: 0.5rem;">
        <button type="button" class="btn btn-outline" id="cancel-view-profile-btn">
          Close
        </button>
      </div>
    </div>
  </div>
</div>