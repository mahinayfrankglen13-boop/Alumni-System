<% layout('layouts/alumniboilerplate') %>

  <main class="main-content">
    <div class="section-header-flex">
      <div>
        <h1 style="font-size: 1.6rem; font-weight: 800; color: var(--slate-900);">Campus Announcements</h1>
        <p style="color: var(--slate-500); font-size: 0.9rem;">Official institutional announcements from MSU-MCEST.</p>
      </div>

      <% if (currentUser && currentUser.role==='admin' ) { %>
        <button class="btn btn-primary" id="post-announcement-btn">
          <i data-lucide="plus-circle"></i>
          Post Announcement
        </button>
        <% } %>
    </div>

    <div class="announcements-feed-container" style="margin-top: 1.5rem;">
      <% if (announcements && announcements.length> 0) { %>
        <% for (let ann of announcements) { %>
          <div class="announcement-card">
            <div class="announcement-card-header"
              style="display: flex; justify-content: space-between; align-items: center;">
              <div>
                <span class="announcement-badge">Campus Announcement</span>
                <span class="announcement-date">
                  <%= new Date(ann.createdAt).toLocaleDateString() %>
                </span>
              </div>

              <% if (currentUser && currentUser.role === 'admin' && ann.createdBy && currentUser._id.toString() === (ann.createdBy._id || ann.createdBy).toString()) { %>
                <div style="display: flex; gap: 8px;">
                  <button type="button" class="btn btn-outline btn-sm open-edit-ann-btn"
                    data-id="<%= ann._id %>" data-title="<%= ann.title %>" data-content="<%= ann.content %>">
                    <i data-lucide="pencil" style="width: 14px; height: 14px;"></i>
                    Edit
                  </button>

                  <form action="/alumni/announcement/<%= ann._id %>?_method=DELETE" method="POST"
                    style="display: inline;"
                    class="delete-confirm-form"
                    data-confirm="Are you sure you want to delete this announcement?">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                      <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                      Delete
                    </button>
                  </form>
                </div>
                <% } %>
            </div>

            <h3 class="announcement-title">
              <%= ann.title %>
            </h3>
            <p class="announcement-body">
              <%= ann.content %>
            </p>
          </div>
          <% } %>
            <% } else { %>
              <p style="color: var(--slate-500);">No campus announcements posted yet.</p>
              <% } %>
    </div>
  </main>

  <% if (currentUser && currentUser.role==='admin' ) { %>
    <!-- POST ANNOUNCEMENT MODAL -->
    <div class="modal-backdrop" id="post-announcement-modal">
      <div class="modal-card" style="max-width: 540px;">
        <div class="modal-header">
          <h3>Post New Announcement</h3>
          <button type="button" class="modal-close-btn" id="close-post-ann-btn">&times;</button>
        </div>

        <form action="/alumni/announcement" method="POST">
          <div class="form-group">
            <label for="post-ann-title">Announcement Title</label>
            <input type="text" id="post-ann-title" name="title" class="form-control"
              placeholder="e.g. 2026 Annual Alumni Homecoming Registration" required />
          </div>

          <div class="form-group">
            <label for="post-ann-content">Announcement Details</label>
            <textarea id="post-ann-content" name="content" class="form-control" rows="5"
              placeholder="Provide full details of the campus announcement..." required></textarea>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem;">
            <button type="button" class="btn btn-outline" id="cancel-post-ann-btn">Cancel</button>
            <button type="submit" class="btn btn-primary">Publish Announcement</button>
          </div>
        </form>
      </div>
    </div>

    <!-- EDIT ANNOUNCEMENT MODAL -->
    <div class="modal-backdrop" id="edit-announcement-modal">
      <div class="modal-card" style="max-width: 540px;">
        <div class="modal-header">
          <h3>Edit Announcement</h3>
          <button type="button" class="modal-close-btn" id="close-edit-ann-btn">&times;</button>
        </div>

        <form id="edit-announcement-form" method="POST">
          <div class="form-group">
            <label for="edit-ann-title">Announcement Title</label>
            <input type="text" id="edit-ann-title" name="title" class="form-control" required />
          </div>

          <div class="form-group">
            <label for="edit-ann-content">Announcement Details</label>
            <textarea id="edit-ann-content" name="content" class="form-control" rows="5" required></textarea>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem;">
            <button type="button" class="btn btn-outline" id="cancel-edit-ann-btn">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Changes</button>
          </div>
        </form>
      </div>
    </div>
    <% } %>