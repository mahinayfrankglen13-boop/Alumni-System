<% layout('layouts/alumniboilerplate') %>

  <main class="main-content">
    <div class="profile-card-header">
      <div class="profile-avatar-xl" id="profile-avatar-upload" title="Click to upload profile photo">
        <img id="profile-img-preview"
          src="<%= (currentUser.profileImage && currentUser.profileImage.url) ? currentUser.profileImage.url : 'https://res.cloudinary.com/fad0iwxm/image/upload/v1786894165/defaul-prof_ryln3w.jpg' %>"
          alt="Profile Photo" style="width:100%;height:100%;object-fit:cover;">

        <div class="profile-avatar-upload-overlay">
          <i data-lucide="upload" style="width:18px;height:18px;margin-bottom:2px;"></i>
          Upload
        </div>

        <input type="file" id="profile-photo-input" accept="image/*" style="display:none;">
      </div>

      <div class="profile-name-title">
        <h2 id="profile-display-name">
          <%= currentUser.fullName %>
        </h2>

        <div class="profile-degree">
          <span id="profile-display-degree-text">
            <%= currentUser.course.courseCode %>
          </span>
          &bull;
          Batch <span id="profile-display-batch-text">
            <%= currentUser.graduationYear %>
          </span>
        </div>

        <div style="margin-top:6px;">
          <% if (currentUser.profileVisibility==='public' ) { %>
            <span class="privacy-status-badge public" id="privacy-badge">
              <i data-lucide="globe" style="width:14px;height:14px;"></i>
              Public Profile
            </span>
            <% } else { %>
              <span class="privacy-status-badge private" id="privacy-badge">
                <i data-lucide="lock" style="width:14px;height:14px;"></i>
                Private Profile
              </span>
              <% } %>
        </div>
      </div>

      <div class="header-privacy-group">
        <div class="header-privacy-pill">
          <% if (currentUser.profileVisibility==='public' ) { %>
            <i data-lucide="globe" id="privacy-header-icon" style="width:14px;height:14px;color:#FFFFFF;"></i>
            <span id="privacy-header-label" style="font-size:0.8rem;font-weight:700;color:white;">Public</span>
            <% } else { %>
              <i data-lucide="lock" id="privacy-header-icon"
                style="width:14px;height:14px;color:rgba(255,255,255,0.7);"></i>
              <span id="privacy-header-label" style="font-size:0.8rem;font-weight:700;color:white;">Private</span>
              <% } %>

                <label class="toggle-switch-sm">
                  <input type="checkbox" id="privacy-main-toggle" <%= currentUser.profileVisibility==='public' ? 'checked' : '' %>>
                  <span class="toggle-slider"></span>
                </label>
        </div>

        <button type="button" class="btn"
          style="background:rgba(255,255,255,0.18);color:#FFFFFF;border:1px solid rgba(255,255,255,0.35);backdrop-filter:blur(4px);"
          id="edit-profile-btn">
          <i data-lucide="edit-3" style="width:16px;height:16px;"></i>
          Edit Profile
        </button>
      </div>
    </div>

    <div class="profile-sections-grid">
      <div>
        <div class="profile-card-block">
          <h3>
            <i data-lucide="user" style="color:var(--primary);"></i>
            Personal & Academic Details
          </h3>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;font-size:0.9rem;">
            <div>
              <div style="color:var(--slate-400);font-weight:700;">Full Name</div>
              <div id="profile-detail-name" style="font-weight:700;color:var(--slate-900);">
                <%= currentUser.fullName %>
              </div>
            </div>

            <div>
              <div style="color:var(--slate-400);font-weight:700;">Email Address</div>
              <div id="profile-display-email" style="font-weight:700;color:var(--slate-900);">
                <%= currentUser.email %>
              </div>
            </div>

            <div>
              <div style="color:var(--slate-400);font-weight:700;">Graduation Year</div>
              <div id="profile-display-grad" style="font-weight:700;color:var(--slate-900);">
                <%= currentUser.graduationYear %>
              </div>
            </div>

            <div>
              <div style="color:var(--slate-400);font-weight:700;">Course</div>
              <div style="font-weight:700;color:var(--slate-900);">
                <%= currentUser.course.courseCode %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div>
        <div class="profile-card-block">
          <h3>
            <i data-lucide="file-text" style="color:var(--gold);"></i>
            About Me
          </h3>

          <div id="profile-display-bio" style="font-size:0.9rem;color:var(--slate-600);line-height:1.6;">
            <%= currentUser.bio || 'No bio provided.' %>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- EDIT PROFILE MODAL -->
  <div class="modal-backdrop" id="edit-profile-modal">
    <div class="modal-card" style="max-width:580px;">
      <div class="modal-header">
        <h3 style="display:flex;align-items:center;gap:8px;color:var(--primary);">
          <i data-lucide="edit-3" style="width:20px;height:20px;"></i>
          Edit Profile Information
        </h3>

        <button class="modal-close-btn" id="close-edit-profile-btn">
          &times;
        </button>
      </div>

      <form action="/alumni/profile?_method=PUT" method="POST" enctype="multipart/form-data">
        <div class="modal-body" style="display:flex;flex-direction:column;gap:1.25rem;">

          <!-- PHOTO -->
          <div
            style="display:flex;align-items:center;gap:1.25rem;background:var(--slate-50);padding:1rem;border-radius:var(--radius-md);border:1px solid var(--slate-200);">
            <div
              style="width:64px;height:64px;border-radius:50%;background:var(--slate-200);display:flex;align-items:center;justify-content:center;overflow:hidden;border:2px solid var(--slate-300);flex-shrink:0;">
              <img id="modal-photo-preview"
                src="<%= (currentUser.profileImage && currentUser.profileImage.url) ? currentUser.profileImage.url : 'https://res.cloudinary.com/fad0iwxm/image/upload/v1786894165/defaul-prof_ryln3w.jpg' %>"
                alt="Preview" style="width:100%;height:100%;object-fit:cover;">
            </div>

            <div style="flex:1;">
              <label style="font-size:0.85rem;font-weight:700;color:var(--slate-800);display:block;margin-bottom:4px;">
                Profile Photo
              </label>

              <input type="file" name="profileImage" id="modal-file-input" accept="image/*" class="form-control"
                style="font-size:0.82rem;">
              <span style="font-size:0.75rem;color:var(--slate-500);">
                PNG, JPG or WEBP
              </span>
            </div>
          </div>

          <!-- NAME + EMAIL -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div class="form-group">
              <label style="font-size:0.82rem;font-weight:700;color:var(--slate-700);">
                Full Name
              </label>
              <input type="text" name="fullName" class="form-control" value="<%= currentUser.fullName %>" required>
            </div>

            <div class="form-group">
              <label style="font-size:0.82rem;font-weight:700;color:var(--slate-700);">
                Email Address
              </label>

              <input type="email" name="email" class="form-control" value="<%= currentUser.email %>" required>
            </div>
          </div>

          <!-- COURSE + YEAR -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div class="form-group">
              <label style="font-size:0.82rem;font-weight:700;color:var(--slate-700);">
                Degree / Course
              </label>

              <input type="text" class="form-control" value="<%= currentUser.course.courseCode %>" disabled>

              <small style="color:var(--slate-500);">
                Course is managed by the administrator.
              </small>
            </div>

            <div class="form-group">
              <label style="font-size:0.82rem;font-weight:700;color:var(--slate-700);">
                Graduation Year
              </label>

              <input type="number" name="graduationYear" class="form-control" value="<%= currentUser.graduationYear %>"
                required>
            </div>
          </div>

          <!-- BIO -->
          <div class="form-group">
            <label style="font-size:0.82rem;font-weight:700;color:var(--slate-700);">
              Bio
            </label>

            <textarea name="bio" class="form-control" rows="4"
              placeholder="Tell other alumni a little about yourself..."><%= currentUser.bio || '' %></textarea>
          </div>

          <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:0.5rem;">
            <button type="button" class="btn btn-outline" id="cancel-edit-profile-btn">
              Cancel
            </button>

            <button type="submit" class="btn btn-primary">
              Save Profile Changes
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>