<aside class="left-sidebar" id="left-sidebar">
  <div class="sidebar-section">

    <div class="nav-category">
      <span class="nav-category-title">Alumni Portal</span>
      <ul class="sidebar-nav-list">
        <li class="sidebar-nav-item">
          <a href="/alumni/dashboard" class="<%= page === 'home' ? 'active' : '' %>">
            <i data-lucide="home" class="nav-icon"></i>
            <span class="sidebar-label">Home Feed</span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="/alumni/directory" class="<%= page === 'directory' ? 'active' : '' %>">
            <i data-lucide="users" class="nav-icon"></i>
            <span class="sidebar-label">Alumni Directory</span>
            <span class="sidebar-badge primary"><%= alumniCount %></span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="/alumni/jobs" class="<%= page === 'jobs' ? 'active' : '' %>">
            <i data-lucide="briefcase" class="nav-icon"></i>
            <span class="sidebar-label">Job Opportunities</span>
            <span class="sidebar-badge gold"><%= jobsCount %></span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="/alumni/announcement" class="<%= page === 'announcements' ? 'active' : '' %>">
            <i data-lucide="megaphone" class="nav-icon"></i>
            <span class="sidebar-label">Announcements</span>
            <span class="sidebar-badge primary"><%= announcementsCount %></span>
          </a>
        </li>
      </ul>
    </div>
    <% if (currentUser && currentUser.role === 'admin') { %>
      <div class="nav-category">
        <span class="nav-category-title">Administration</span>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item">
            <a href="/alumni/courses" class="<%= page === 'courses' ? 'active' : '' %>">
              <i data-lucide="book-open" class="nav-icon"></i>
              <span class="sidebar-label">Course Management</span>
              <span class="sidebar-badge primary"><%= coursesCount %></span>
            </a>
          </li>
        </ul>
      </div>
    <% } %>
    <div class="nav-category">
      <span class="nav-category-title">Connect & Account</span>
      <ul class="sidebar-nav-list">
        <li class="sidebar-nav-item">
          <a href="/alumni/profile" class="<%= page === 'profile' ? 'active' : '' %>">
            <i data-lucide="user" class="nav-icon"></i>
            <span class="sidebar-label">My Profile</span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <form action="/logout" method="POST" class="sidebar-logout-form">
            <button type="submit" class="logout-link">
              <i data-lucide="log-out" class="nav-icon"></i>
              <span class="sidebar-label">Log Out</span>
            </button>
          </form>
        </li>
      </ul>
    </div>

  </div>

  <!-- Collapse Sidebar Button -->
  <div class="sidebar-footer">
    <button class="collapse-btn" id="sidebar-collapse-btn">
      <i data-lucide="panel-left-close" style="width: 18px; height: 18px;"></i>
      <span class="sidebar-label">Collapse Sidebar</span>
    </button>
  </div>
</aside>
